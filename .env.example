# Copie ce fichier en « .env » pour un usage local. Sur GitHub, ces valeurs vont dans Settings → Secrets → Actions.
# Ne publie JAMAIS le fichier .env (il est déjà dans .gitignore).

# ── Telegram (@BotFather → /newbot) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # python -m radar telegram-chat-id (après un /start à ton bot). Plusieurs : 123,456
TELEGRAM_THREAD_ID=          # optionnel : id d'un sujet dans un groupe à forums

# ── Discord (Paramètres du salon → Intégrations → Webhooks) ──────
DISCORD_WEBHOOK_URL=

# ── Alertes e-mail (LinkedIn, Indeed, WTTJ…) via Gmail IMAP ──────
IMAP_USER=                   # ton adresse Gmail
IMAP_PASSWORD=               # mot de passe d'APPLICATION (pas ton mot de passe Gmail)
IMAP_HOST=imap.gmail.com

# ── APIs gratuites (optionnelles) ────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=
